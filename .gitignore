# Rust
/target/
**/*.rs.bk
*.pdb
# Direct `rustc` metadata emitted in the repository root.
/*.rmeta

# Cargo.lock is versioned because Rugra ships binaries and locked oracle
# runners; reproducible offline validation requires an exact dependency graph.

# IDE
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
/build/
/dist/
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Test binaries
/tests/binaries/*.o
/tests/output/

# Coverage
*.profraw
*.profdata
/coverage/

# Documentation
/target/doc/

# Temporary files
*.tmp
*.log

# Decompilation output / debug artifacts (regenerable, do not commit)
/result/

# Content-addressed oracle outputs and pipeline snapshots (regenerable)
/.rudra-cache/

# Agent/tooling scratch dirs (session-local)
.sisyphus/
.agents/
.githooks/

# Align-gate runtime state (see docs/alignment_docs/HOOK_GUIDE.md)
.alignment_receipts.json
.alignment_session_start
.zcode/align_gate.log

# python pycache
.zcode/__pycache__/
tools/__pycache__/

# Vendored Ghidra source (reference only, do not commit; huge tree)
/ghidra/

# Local oracle tree symlink (worktrees only; the main repo has ghidra/ as
# untracked checkout)
/ghidra/

# deepwork session state
.slim/deepwork/
