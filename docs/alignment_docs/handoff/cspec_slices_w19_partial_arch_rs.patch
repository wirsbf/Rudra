+// Ghidra: type.hh:763-771 TypeFactory data-organization fields
+/// The data-organization ingest state driven by the `<data_organization>`,
+/// `<enum>` children and the post-loop `types->setupSizes()` step of
+/// `Architecture::parseCompilerConfig` (architecture.cc:1268-1271, 1350).
+///
+/// Mirrors the `TypeFactory` fields (type.hh:763-771) with the exact
+/// constructor defaults (`TypeFactory::TypeFactory`, type.cc:3106-3118:
+/// every size 0, `alignMap` empty) and the exact write semantics of
+/// `decodeDataOrganization` (type.cc:4583-4615),
+/// `decodeAlignmentMap`/`setDefaultAlignmentMap` (type.cc:4619-4656),
+/// `parseEnumConfig` (type.cc:4662-4672) and `setupSizes`
+/// (type.cc:3137-3170).  Installing these values into the live
+/// `crate::type_system::typefactory::TypeFactory` is the registered
+/// residual CSPEC-TYPEORG-STATE-0001.
+#[derive(Debug, Clone, Default)]
+pub struct DataOrganizationState {
+    /// Size of the core "int" data-type (`sizeOfInt`).
+    pub size_of_int: i32,
+    /// Size of the core "long" data-type (`sizeOfLong`).
+    pub size_of_long: i32,
+    /// Size of the core "char" data-type (`sizeOfChar`).
+    pub size_of_char: i32,
+    /// Size of the core "wchar_t" data-type (`sizeOfWChar`).
+    pub size_of_wchar: i32,
+    /// Size of pointers into the default data space (`sizeOfPointer`).
+    pub size_of_pointer: i32,
+    /// Size of alternate (far) pointers, or 0 (`sizeOfAltPointer`).
+    pub size_of_alt_pointer: i32,
+    /// Size of an enumerated type (`enumsize`).
+    pub enum_size: i32,
+    /// Default enumeration meta-type (`enumtype`).  Ghidra's field is
+    /// uninitialized until `parseEnumConfig` or `setupSizes` assigns it;
+    /// `None` models the never-assigned state.
+    pub enum_type: Option<EnumConfigType>,
+    /// Alignment of primitive data-types by size (`alignMap`); `-1`
+    /// marks sizes never explicitly listed before the fill-in loop.
+    pub align_map: Vec<i32>,
+}
+
+impl DataOrganizationState {
+    // Ghidra: type.cc:3088 TypeFactory::getAlignment
+    /// Alignment of a primitive data-type of the given size.  Faithful to
+    /// `TypeFactory::getAlignment` (type.cc:3088-3097): a size beyond the
+    /// map reads the LAST entry, and an empty map is the
+    /// `TypeFactory alignment map not initialized` error (only reachable
+    /// before `setupSizes`).
+    pub fn get_alignment(&self, size: usize) -> Result<i32, String> {
+        if size >= self.align_map.len() {
+            if self.align_map.is_empty() {
+                return Err("TypeFactory alignment map not initialized".to_string());
+            }
+            return Ok(self.align_map[self.align_map.len() - 1]);
+        }
+        Ok(self.align_map[size])
+    }
+}
