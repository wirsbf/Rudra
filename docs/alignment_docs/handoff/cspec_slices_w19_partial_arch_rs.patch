+// Ghidra: type.hh:81 type_metatype (TYPE_ENUM_INT / TYPE_ENUM_UINT values)
+/// The default enumeration meta-type written by `<enum>` decode and
+/// `setupSizes`.  Ghidra stores a full `type_metatype` in
+/// `TypeFactory::enumtype` (type.hh:770); only `TYPE_ENUM_INT` (5) and
+/// `TYPE_ENUM_UINT` (6) are reachable through the compiler-spec chain
+/// (`TypeFactory::parseEnumConfig`, type.cc:4667-4670, and the
+/// `enumsize == 0` default in `setupSizes`, type.cc:3168), so the mirror
+/// keeps just those two, exposing the numeric metatype for projections.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EnumConfigType {
+    /// `TYPE_ENUM_INT` (type.hh:92) — signed enumeration.
+    EnumInt,
+    /// `TYPE_ENUM_UINT` (type.hh:93) — unsigned enumeration.
+    EnumUint,
+}
+
+impl EnumConfigType {
+    // RUDRA-GLUE: metatype (Ghidra stores the raw type_metatype value)
+    /// The numeric `type_metatype` of this enumeration flavor.
+    pub fn metatype(&self) -> i32 {
+        match self {
+            EnumConfigType::EnumInt => 5,  // TYPE_ENUM_INT
+            EnumConfigType::EnumUint => 6, // TYPE_ENUM_UINT
+        }
+    }
+}
